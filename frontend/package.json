    "three": "^0.183.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
