{
  "name": "@raiquora/agent-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1118.0",
    "@aws-sdk/client-dynamodb": "^3.1118.0",
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-secrets-manager": "^3.1118.0",
    "@raiquora/journey": "*",
    "@raiquora/operation": "*",
    "@raiquora/trip": "*",
    "@raiquora/agent": "*"
  },
  "scripts": {
    "build": "npm run typecheck && npm run bundle:lambda && npm run bundle:trip-changed && npm run bundle:rail-impact && npm run bundle:trip-recheck && npm run bundle:notification",
    "typecheck": "tsc --noEmit",
    "bundle:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/lambda/index.cjs",
    "bundle:trip-changed": "esbuild src/trip-changed-lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/trip-changed/index.cjs",
    "bundle:rail-impact": "esbuild src/rail-impact-lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/rail-impact/index.cjs",
    "bundle:trip-recheck": "esbuild src/trip-recheck-lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/trip-recheck/index.cjs",
    "bundle:notification": "esbuild src/notification-lambda.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/notification/index.cjs",
    "lambda:check": "node ../../tools/check_lambda_package.mjs",
    "test": "TMPDIR=/tmp vitest run --root ../.. backend/agent-api/src"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
