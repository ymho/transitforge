# Copy this file to .env.local and set local public display values.
# Do not commit .env.local. Provider-specific names and attribution URLs stay there.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_ACCOMMODATION_PROVIDER_DISPLAY_NAME=
VITE_ACCOMMODATION_PROVIDER_CREDIT_URL=
VITE_ACCOMMODATION_PROVIDER_CREDIT_IMAGE_URL=
VITE_ACCOMMODATION_PROVIDER_CREDIT_ALT=

# #480 short-lived cutover gate; enable only after REST/state/provider preparation and AWS validation.
# true selects Server Agent only; errors never fall back to the Browser Agent.
VITE_SERVER_AGENT_ENABLED=false
