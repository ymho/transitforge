{
  "name": "transitforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/*",
    "modules/*",
    "lib"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @raiquora/frontend",
    "build": "npm run build --workspace @raiquora/frontend",
    "test": "npm run test --workspace @raiquora/frontend",
    "workspace:check": "node tools/check_workspace_layout.mjs",
    "architecture:check": "npm run workspace:check && node tools/check_architecture_boundaries.mjs",
    "assets:check": "npm run assets:check --workspace @raiquora/frontend",
    "eval:agent": "node --import tsx tools/run_agent_evaluation.ts",
    "eval:agent:smoke": "npm run eval:agent -- --profile smoke",
    "eval:agent:full": "npm run eval:agent -- --profile full",
    "eval:agent:strategies": "node --import tsx tools/run_agent_strategy_experiment.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
