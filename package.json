{
  "name": "transitforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/*",
    "modules/*",
    "lib"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @raiquora/frontend",
    "build": "npm run typecheck:tools && npm run build --workspace @raiquora/frontend && npm run build --workspace @raiquora/agent-api",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "bundle:check": "node tools/check_bundle_budget.mjs dist/assets",
    "test": "npm run test --workspace @raiquora/frontend && npm run test --workspace @raiquora/agent-api",
    "workspace:check": "node tools/check_workspace_layout.mjs",
    "architecture:check": "npm run workspace:check && node --test tools/browser_global_reference.test.mjs && node tools/check_architecture_boundaries.mjs",
    "lambda:check": "npm run build --workspace @raiquora/agent-api && npm run lambda:check --workspace @raiquora/agent-api",
    "test:journey-scenarios": "vitest run modules/journey/domain/journey-search-engine.test.ts",
    "eval:agent": "node --import tsx tools/run_agent_evaluation.ts",
    "eval:agent:smoke": "npm run eval:agent -- --profile smoke",
    "eval:agent:full": "npm run eval:agent -- --profile full",
    "eval:agent:model:live": "node --import tsx tools/run_live_agent_model_evaluation.ts",
    "test:agent:model:live-fixtures": "vitest run --root . frontend/src/usecases/agent/evaluation/live-model-tool-fixture.test.ts",
    "eval:agent:strategies": "node --import tsx tools/run_agent_strategy_experiment.ts",
    "eval:epic-537:scale": "node --import tsx tools/run_epic_537_scale_evaluation.ts",
    "eval:agent:model-routing:build": "node --import tsx tools/build_agent_model_routing_run.ts",
    "eval:agent:model-routing": "node --import tsx tools/compare_agent_model_routing.ts",
    "test:agent-cutover:browser": "vitest run tools/agent-transport/production-cutover.test.ts --maxWorkers=1"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
