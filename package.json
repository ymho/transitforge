{
  "name": "transitforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/*",
    "modules/*",
    "lib"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @raiquora/frontend",
    "build": "npm run typecheck:tools && npm run build --workspace @raiquora/frontend && npm run build --workspace @raiquora/agent-api",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "bundle:check": "node tools/check_bundle_budget.mjs dist/assets",
    "test": "npm run test --workspace @raiquora/frontend && npm run test --workspace @raiquora/agent-api && npm run test:agent-stream-contract && npm run test:agent:strands:live-fixtures",
    "test:agent-stream-contract": "vitest run tools/agent-transport/stream-contract.test.ts",
    "workspace:check": "node tools/check_workspace_layout.mjs",
    "architecture:check": "npm run workspace:check && node --test tools/browser_global_reference.test.mjs && node tools/check_architecture_boundaries.mjs",
    "lambda:check": "npm run build --workspace @raiquora/agent-api && npm run lambda:check --workspace @raiquora/agent-api",
    "test:journey-scenarios": "vitest run modules/journey/domain/journey-search-engine.test.ts",
    "eval:agent": "node --import tsx tools/run_agent_evaluation.ts",
    "eval:agent:smoke": "npm run eval:agent -- --profile smoke",
    "eval:agent:full": "npm run eval:agent -- --profile full",
    "eval:agent:model:live": "node --import tsx tools/run_live_agent_model_evaluation.ts",
    "eval:agent:semantic:live": "node --import tsx tools/run_live_semantic_intent_evaluation.ts",
    "test:agent:model:live-fixtures": "vitest run --root . frontend/src/usecases/agent/evaluation/live-model-tool-fixture.test.ts",
    "eval:agent:strategies": "node --import tsx tools/run_agent_strategy_experiment.ts",
    "eval:epic-537:scale": "node --import tsx tools/run_epic_537_scale_evaluation.ts",
    "eval:agent:model-routing:build": "node --import tsx tools/build_agent_model_routing_run.ts",
    "eval:agent:model-routing": "node --import tsx tools/compare_agent_model_routing.ts",
    "test:agent-cutover:browser": "vitest run tools/agent-transport/production-cutover.test.ts --maxWorkers=1",
    "eval:agent:strands:live": "node --import tsx tools/run_live_strands_v2_evaluation.ts",
    "eval:trip:v2": "node --import tsx tools/run_trip_v2_product_gate.ts",
    "test:trip:v2:gate": "vitest run --root . tools/trip-v2-product-gate.test.ts",
    "test:trip:v2:bedrock": "vitest run --root . backend/agent-api/src/composition/strands-trip-product-live.test.ts --maxWorkers=1",
    "test:agent:strands:live-fixtures": "vitest run --root . tools/strands-v2-live-evaluation.test.ts",
    "test:agent:v2": "vitest run --root . backend/agent-api/src/adapters/dynamodb-conversation-turn-repository.test.ts backend/agent-api/src/usecases/agent/conversation-turn.test.ts backend/agent-api/src/adapters/strands-agent-engine.test.ts backend/agent-api/src/adapters/strands-server-runtime.test.ts backend/agent-api/src/composition/strands-conversation-production-shaped.test.ts backend/agent-api/src/composition/strands-intent-acceptance.test.ts backend/agent-api/src/composition/conversation-server-agent.test.ts backend/agent-api/src/composition/agent-v2-acceptance-catalog.test.ts backend/agent-api/src/usecases/agent-v2-system-prompt.test.ts backend/agent-api/src/usecases/purpose-travel-tools.test.ts backend/agent-api/src/usecases/plan-candidate-retention.test.ts backend/agent-api/src/composition/production-server-tools.test.ts backend/agent-api/src/production-server-agent-composition.test.ts tools/strands-v2-live-evaluation.test.ts tools/trip-v2-product-gate.test.ts modules/agent/runtime/agent-v2-publication.test.ts modules/agent/runtime/agent-v2-candidates.test.ts backend/agent-api/src/composition/strands-place-cards-acceptance.test.ts backend/agent-api/src/adapters/dynamodb-place-presentation.test.ts frontend/src/presentation/concierge/public-place-presentation-view.test.ts backend/agent-api/src/usecases/agent/server-agent-diagnostics.test.ts backend/agent-api/src/adapters/strands-runtime-diagnostics.test.ts modules/agent/runtime/agent-v2-reply.test.ts backend/agent-api/src/adapters/strands-structured-output.test.ts modules/agent/runtime/conversation-condition.test.ts backend/agent-api/src/adapters/dynamodb-condition-operations.test.ts backend/agent-api/src/usecases/agent/conversation-condition-application.test.ts modules/agent/runtime/verified-intent-proposal.test.ts modules/agent/runtime/agent-v2-condition-display.test.ts backend/agent-api/src/composition/strands-free-dialogue.test.ts",
    "test:agent:v2:conversation-live": "vitest run --root . backend/agent-api/src/composition/strands-output-live.test.ts backend/agent-api/src/composition/strands-concise-answer-live.test.ts --maxWorkers=1",
    "test:agent:v2:condition-live": "vitest run --root . backend/agent-api/src/composition/strands-condition-tools-live.test.ts --maxWorkers=1",
    "test:agent:v2:party-live": "vitest run --root . backend/agent-api/src/composition/strands-party-condition-live.test.ts --maxWorkers=1",
    "test:agent:v2:period-live": "vitest run --root . backend/agent-api/src/composition/strands-travel-period-live.test.ts --maxWorkers=1",
    "test:agent:v2:budget-live": "vitest run --root . backend/agent-api/src/composition/strands-budget-condition-live.test.ts --maxWorkers=1",
    "test:agent:v2:free-dialogue-live": "vitest run --root . backend/agent-api/src/composition/strands-free-dialogue.test.ts --maxWorkers=1"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
