{
  "name": "transitforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:check && tsc --noEmit && vite build",
    "test": "TMPDIR=/tmp vitest run",
    "architecture:check": "node tools/check_architecture_boundaries.mjs",
    "assets:check": "node --import tsx tools/check_concierge_assets.ts",
    "eval:agent": "node --import tsx tools/run_agent_evaluation.ts",
    "eval:agent:smoke": "npm run eval:agent -- --profile smoke",
    "eval:agent:full": "npm run eval:agent -- --profile full",
    "eval:agent:strategies": "node --import tsx tools/run_agent_strategy_experiment.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mapbox-gl": "^3.25.0",
    "three": "^0.183.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.10"
  }
}
