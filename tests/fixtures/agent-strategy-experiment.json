        { "caseId": "station-then-search", "toolSequence": ["inspect_station", "search_journeys"], "normalizedConstraints": { "originStation": "京都", "destinationStation": "大阪" }, "status": "completed", "claimStatuses": ["supported", "supported"], "viewerActions": [{ "actionType": "highlight_route", "status": "applied" }] },
        { "caseId": "missing-origin", "toolSequence": [], "normalizedConstraints": { "destinationStation": "京都" }, "status": "follow_up", "claimStatuses": [], "viewerActions": [] },
        { "caseId": "delayed-transfer", "toolSequence": ["search_journeys"], "normalizedConstraints": { "useRealtime": true }, "status": "completed", "claimStatuses": ["supported"], "viewerActions": [{ "actionType": "show_evidence", "status": "applied" }] },
        { "caseId": "exclude-shinkansen", "toolSequence": ["search_journeys"], "normalizedConstraints": { "excludedServiceTypes": ["新幹線"] }, "status": "completed", "claimStatuses": ["supported"], "viewerActions": [{ "actionType": "highlight_route", "status": "applied" }] },
        { "caseId": "inspect-train", "toolSequence": ["inspect_train"], "normalizedConstraints": { "serviceUid": "service-a" }, "status": "completed", "claimStatuses": ["supported"], "viewerActions": [{ "actionType": "show_evidence", "status": "applied" }] }
      ]
    },
    {
      "id": "always-on-reflection",
      "measurement": { "modelCalls": 24, "toolCalls": 11, "totalLatencyMs": 1920, "inputTokens": 4800, "outputTokens": 1200 },
      "observations": [
        { "caseId": "ambiguous-station", "toolSequence": ["inspect_station"], "normalizedConstraints": { "stationName": "大阪" }, "status": "follow_up", "claimStatuses": ["unknown"], "viewerActions": [] },
