aws_region   = "ap-northeast-1"
project_name = "transitforge"
environment  = "dev"

# 既定では単一modelを使う。比較評価時だけ任意のmodel classを設定する。
# bedrock_model_id             = "amazon.nova-lite-v1:0"
# bedrock_lightweight_model_id = ""
# bedrock_decision_model_id    = "jp.amazon.nova-2-lite-v1:0"

github_repository                = "example/transitforge"
data_builder_github_oidc_subject = "repo:example@12345/transitforge-data-builder@67890:environment:dev"

# 平文のパスワードではなく、次の値を設定する。
# printf 'trf:<PASSWORD>' | sha256sum
basic_auth_username           = "trf"
basic_auth_credentials_sha256 = "REPLACE_WITH_64_CHARACTER_LOWERCASE_SHA256"

# Cloudflare AOPの準備と疎通確認に合わせて段階的に有効化する。
viewer_domain_name                      = "app.ohmyki.com"
cloudflare_front_door_enabled           = false
legacy_cloudfront_redirect_enabled      = false
